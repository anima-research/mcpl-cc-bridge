{
  "servers": {
    "toy": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ]
      },
      "grant": [
        "tools",
        "pushEvents",
        "inferenceRequest",
        "inferenceLifecycle",
        "channels.register",
        "channels.lifecycle",
        "channels.incoming",
        "channels.publish",
        "contextHooks.beforeInference.observe",
        "contextHooks.beforeInference.inject.beforeUser"
      ],
      "enableFeatureSets": [
        "*"
      ],
      "inferenceRequest": "channel",
      "wake": "chat",
      "openChannels": [
        "toy:lobby"
      ]
    },
    "toy2": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ]
      },
      "openOnAddressed": true
    },
    "toygate": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ]
      },
      "grant": [
        "tools",
        "pushEvents",
        "inferenceRequest",
        "inferenceLifecycle",
        "channels.register",
        "channels.lifecycle",
        "channels.incoming",
        "channels.publish",
        "contextHooks.beforeInference.observe",
        "contextHooks.beforeInference.inject.beforeUser"
      ],
      "enableFeatureSets": [
        "*"
      ],
      "inferenceRequest": "deny",
      "openChannelsOnly": true,
      "dmAllowlist": [
        "u2"
      ]
    },
    "toyoff": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ]
      },
      "disabled": true
    },
    "toyoff__deep": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ]
      },
      "disabled": true
    },
    "toycrash": {
      "transport": {
        "command": "bun",
        "args": [
          "-e",
          "process.stderr.write('toycrash: cannot find'); setTimeout(() => { process.stderr.write(' module ./dist/index.js\\n'); process.exit(3) }, 50)"
        ]
      },
      "disabled": true
    },
    "toynocmd": {
      "transport": {
        "command": "/nonexistent/mcpl-server-binary"
      },
      "disabled": true
    },
    "toyslow": {
      "transport": {
        "command": "bun",
        "args": [
          "run",
          "test/toy-server.ts"
        ],
        "env": {
          "TOY_LINGER_MS": "1500"
        }
      },
      "inferenceRequest": "deny",
      "disabled": true
    }
  }
}
